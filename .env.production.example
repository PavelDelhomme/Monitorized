# Monitorized — exemple production Portainer/VPS
# Ne pas committer le vrai .env.
# Préparation :
#   cp .env.production.example .env
#   make secrets

# Écoute interne du conteneur. Ne pas mettre 0.0.0.0 public ici.
MONITORIZED_ADDR=:8080
MONITORIZED_DATA_DIR=/data

# Identifiants dashboard.
# Change le user si tu veux, puis colle les valeurs générées par `make secrets`.
MONITORIZED_ADMIN_USER=admin
MONITORIZED_ADMIN_PASSWORD=PASTE_GENERATED_ADMIN_PASSWORD_HERE
MONITORIZED_JWT_SECRET=PASTE_GENERATED_JWT_SECRET_HERE

# Domaine public derrière Nginx Proxy Manager.
# Exemple : https://monitorized.delhomme.ovh
MONITORIZED_ALLOWED_ORIGINS=https://monitorized.example.com

# Docker local du VPS, monté en lecture seule par le compose.
DOCKER_HOST=unix:///var/run/docker.sock

# Chemin interne des logs Nginx Proxy Manager montés en lecture seule.
NPM_LOG_GLOB=/data/logs/proxy-host-*_access.log

# Intervalles prudents pour production (léger CPU/RAM).
COLLECT_HOST_INTERVAL=10
COLLECT_DOCKER_INTERVAL=15
COLLECT_NPM_INTERVAL=30
RETENTION_DAYS=14

# Optionnel : webhook n8n/Discord/Telegram plus tard.
ALERT_WEBHOOK_URL=

# Veille compromission gratuite.
COMPROMISE_ENABLED=true
COMPROMISE_INTERVAL=3600
COMPROMISE_SERVER_IP=
COMPROMISE_DETECT_PUBLIC_IP=true
COMPROMISE_AUTO_NPM_DOMAINS=true

# Chemin hôte des logs NPM (utilisé par docker-compose.portainer.yml)
NPM_LOGS_HOST_PATH=/opt/npm/data/logs
