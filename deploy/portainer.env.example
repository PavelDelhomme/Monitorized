# Variables supplémentaires pour Portainer (stack env)
# À coller dans Portainer en plus du contenu de .env

# Chemin hôte des logs Nginx Proxy Manager
NPM_LOGS_HOST_PATH=/opt/npm/data/logs

# Webhook Portainer (optionnel) pour redéploiement auto
# PORTAINER_WEBHOOK_URL=https://portainer.example.com/api/stacks/webhooks/xxxxxxxx
