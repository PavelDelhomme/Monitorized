# Monitorized — exemple local/dev
# Copie vers .env :
#   cp .env.example .env
# Puis génère des valeurs fortes :
#   make secrets

# Adresse d'écoute interne.
# En Docker/Portainer, garder :8080. Le HTTPS doit être géré par Nginx Proxy Manager.
MONITORIZED_ADDR=:8080

# Répertoire de stockage SQLite.
# En Docker, le volume /data est monté par docker-compose.yml.
MONITORIZED_DATA_DIR=./data

# Compte admin de l'interface.
MONITORIZED_ADMIN_USER=admin

# Mot de passe admin. Remplacer par la sortie de `make secrets`.
MONITORIZED_ADMIN_PASSWORD=change-me-strong-password

# Secret JWT de 32+ caractères. Remplacer par la sortie de `make secrets`.
MONITORIZED_JWT_SECRET=generate-a-long-random-secret-min-32-chars

# Origines web autorisées (CORS), séparées par des virgules.
# Local : http://localhost:8080
# Prod : https://monitorized.example.com
MONITORIZED_ALLOWED_ORIGINS=http://localhost:8080

# Socket Docker. Le compose le monte en lecture seule.
DOCKER_HOST=unix:///var/run/docker.sock

# Logs Nginx Proxy Manager vus depuis le conteneur.
NPM_LOG_GLOB=/data/logs/proxy-host-*_access.log

# Fréquence de collecte (secondes).
COLLECT_HOST_INTERVAL=10
COLLECT_DOCKER_INTERVAL=15
COLLECT_NPM_INTERVAL=30

# Rétention SQLite (jours).
RETENTION_DAYS=14

# Webhook d'alerte futur/optionnel (laisser vide si inutilisé).
ALERT_WEBHOOK_URL=

# Veille compromission — cibles gérées dans l'UI (onglet Compromission)
# Pas de clé API payante. HIBP supprimé.
COMPROMISE_ENABLED=true
COMPROMISE_INTERVAL=3600

# Si vide, Monitorized détecte l'IP publique automatiquement.
COMPROMISE_SERVER_IP=
COMPROMISE_DETECT_PUBLIC_IP=true

# Ajoute automatiquement les domaines vus dans les logs NPM comme cibles.
COMPROMISE_AUTO_NPM_DOMAINS=true
